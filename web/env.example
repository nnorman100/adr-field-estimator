# Copy to .env.local for local work. Real values never go in git.
# APP_ENV is required: the app refuses to start without it (checked at start by src/instrumentation.ts).
# Cloud Run gets it from Terraform under the same name. The older APP_ENVIRONMENT is still read.
# Every setting the app reads is listed in src/lib/settings-contract.ts, which a test holds to
# the Terraform in infra/dryscope/app.
APP_ENV=local

# Postgres URL for the rebuilt app. Optional until a command opens the database.
# npm run db:migrate requires it and reads this file; exported variables win.
# Database tests start their own throwaway server when it is unset.
# A value that is set must be a postgres URL. The app refuses to start if it is set and invalid.
# DATABASE_URL=postgres://dryscope@127.0.0.1:5432/dryscope

# Cloud Run only (set by infra/dryscope/app/cloud_run.tf, never locally): SQL_CONNECTION_NAME,
# SQL_DATABASE_NAME and SQL_IAM_USER make the app log in to Cloud SQL over /cloudsql as its IAM
# database user. All three or none, and never together with DATABASE_URL.

# Project whose sign-in tokens the server accepts. Optional until a route checks a sign-in; such a
# route fails closed without it. Cloud Run gets it from Terraform (infra/dryscope/app).
# GOOGLE_CLOUD_PROJECT=demo-dryscope

# Local only: firebase-admin then trusts the Auth emulator's unsigned tokens. The app refuses to
# start when this is set and APP_ENV is not local, the project is not a demo- one, or the address
# is not loopback. Never set it in test or live.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9399

# Field database the server writes access records to. Optional until a record is written; such a
# write fails and waits in the outbox without it. The browser's Firestore client reads it too
# (BrowserSignInConfig). Cloud Run gets it from Terraform (infra/dryscope/app).
# FIRESTORE_DATABASE_ID=(default)

# Local only, with the same limits as the Auth emulator: firebase-admin then writes to the Firestore
# emulator without credentials, and the browser's Firestore client uses it. Never set it in test or live.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8399

# The browser sign-in settings of the project's Firebase web app (S3 plan, section 6, step 8). Both
# values are public. Outside the Auth emulator the sign-in pages say sign-in is not set up until
# both are set.
# FIREBASE_WEB_API_KEY=
# FIREBASE_AUTH_DOMAIN=dryscope.firebaseapp.com

# Local only: a JSON file that stands in for the sign-in records in Postgres, so the sign-in and team
# screens run against the Auth emulator with no database (the Playwright tests write it). Refused unless
# APP_ENV is local, FIREBASE_AUTH_EMULATOR_HOST is set and no database is configured.
# LOCAL_SIGN_IN_FIXTURE=/absolute/path/to/fixture.json

# Request tracing (src/lib/telemetry). Spans are always recorded in the process; they go to Cloud
# Trace only on a Cloud Run service (it sets K_SERVICE) with GOOGLE_CLOUD_PROJECT, never in a local
# run or CI. OTEL_SDK_DISABLED=true (any case) turns tracing off entirely.
# OTEL_SDK_DISABLED=true
