{
  "name": "dryscope-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build && tsx scripts/build-sw.ts",
    "start": "next start --port 3100",
    "gen:routes": "tsx scripts/gen-api-routes.ts",
    "pretypecheck": "npm run gen:routes",
    "typecheck": "tsc --noEmit",
    "prelint": "npm run gen:routes",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:emu": "tsx tests/emu/run.ts",
    "test:isolation": "vitest run --config vitest.db.config.ts tests/db/company-isolation.test.ts tests/db/company-isolation-records.test.ts && tsx tests/emu/run.ts tests/emu/rules/company-isolation.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx src/db/cli.ts",
    "build:migrate": "node scripts/build-migrate.mjs",
    "platform:create-tenant": "tsx scripts/create-tenant.ts",
    "platform:add-operator": "tsx scripts/add-operator.ts",
    "platform:secure-tenants": "tsx scripts/secure-tenants.ts",
    "platform:recaptcha": "tsx scripts/recaptcha-mode.ts",
    "probe:live": "tsx scripts/probe-live.ts",
    "eval:ai": "tsx scripts/eval-ai.ts",
    "eval:audio": "tsx scripts/make-eval-audio.ts",
    "eval:photos": "tsx scripts/render-eval-photos.ts"
  },
  "dependencies": {
    "@google-cloud/modelarmor": "0.13.0",
    "@google/genai": "2.32.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.2",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "firebase": "13.3.0",
    "firebase-admin": "14.5.1",
    "google-auth-library": "11.3.4",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "postgres": "4.1.1",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "fast-check": "4.10.2",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
