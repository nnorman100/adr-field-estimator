{
  "name": "dryscope-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build && tsx scripts/build-sw.ts",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:emu": "tsx tests/emu/run.ts",
    "test:isolation": "vitest run --config vitest.db.config.ts tests/db/company-isolation.test.ts && tsx tests/emu/run.ts tests/emu/rules/company-isolation.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx src/db/cli.ts",
    "build:migrate": "node scripts/build-migrate.mjs",
    "platform:create-tenant": "tsx scripts/create-tenant.ts",
    "platform:add-operator": "tsx scripts/add-operator.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "firebase": "13.1.0",
    "firebase-admin": "14.5.0",
    "google-auth-library": "11.3.4",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "postgres": "4.1.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
