rules_version = '2';

// Rules for the rebuilt app's field database (S3-6). Deny by default: a path no rule below names
// is refused, and so is every create, update or delete a rule does not allow.
//
// Server-written records the rules read (the server SDK is not bound by these rules):
// - companies/{companyId}: the company header. `authTenantId` is the company's sign-in tenant.
// - companies/{companyId}/access/{uid}: one person's access to that company, written by the
//   server after a membership change commits in Postgres. `role` is owner, estimator or office;
//   `expiresAt` is a timestamp, and the record stops working at that time.
// - companies/{companyId}/drafts/{draftId}: a draft. `fieldOwnerUid`, `state` (editing,
//   submitting or submitted), `fence` (the submission holding it, S5a-8) and `previous` (the
//   submitted draft a "Back to editing" version came from) are the server's
//   (web/src/lib/submissions/fence.ts). A client may change only the `field` map.
//
// The `field` maps follow field map v1 (`web/src/lib/field/schema.ts`): the rules check each
// key's type and size and refuse a key the map does not name. Every key is optional; clearing a
// value deletes its key. Rules cannot loop over a list, so `roomOrder` is checked for type, size
// and repeats only, and the server checks its entries when it reads the draft. Lookups stay at
// the company, the access record and the draft (three documents per write).
service cloud.firestore {
  match /databases/{database}/documents {
    function companyPath(companyId) {
      return /databases/$(database)/documents/companies/$(companyId);
    }

    function accessPath(companyId) {
      return /databases/$(database)/documents/companies/$(companyId)/access/$(request.auth.uid);
    }

    // The caller's access record, when the token's sign-in tenant is the company's tenant and the
    // record has not expired; null otherwise. One get() of the company and one of the access
    // record, so every rule below reads at most three documents (with the draft) per write.
    function member(companyId) {
      let company = get(companyPath(companyId));
      let record = get(accessPath(companyId));
      return request.auth != null
        && request.auth.token.firebase.tenant is string
        && company != null
        && company.data.authTenantId == request.auth.token.firebase.tenant
        && record != null
        && record.data.expiresAt is timestamp
        && record.data.expiresAt > request.time ? record.data : null;
    }

    // Owner and office see every draft of their company; an estimator sees only the drafts they
    // own in the field.
    function canRead(companyId, draft) {
      let record = member(companyId);
      return record != null
        && (record.role in ['owner', 'office'] || draft.fieldOwnerUid == request.auth.uid);
    }

    // Only the draft's field owner, holding a role that edits scope, while the draft is editing.
    function canEdit(companyId, draft) {
      let record = member(companyId);
      return record != null
        && record.role in ['owner', 'estimator']
        && draft.fieldOwnerUid == request.auth.uid
        && draft.state == 'editing';
    }

    function changesOnlyField() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['field']);
    }

    // Optional keys of a `field` map: absent, or of the right type and size.
    function okInt(f, k, lo, hi) {
      return !(k in f) || (f[k] is int && f[k] >= lo && f[k] <= hi);
    }

    function okNumber(f, k, lo, hi) {
      return !(k in f) || (f[k] is number && f[k] >= lo && f[k] <= hi);
    }

    function okBool(f, k) {
      return !(k in f) || f[k] is bool;
    }

    function okText(f, k, lo, hi) {
      return !(k in f) || (f[k] is string && f[k].size() >= lo && f[k].size() <= hi);
    }

    function okId(f, k) {
      return okText(f, k, 1, 64) && (!(k in f) || f[k].matches('[A-Za-z0-9_-]+'));
    }

    function okList(f, k, max) {
      return !(k in f) || (f[k] is list && f[k].size() <= max && f[k].toSet().size() == f[k].size());
    }

    function validDraftField(f) {
      return f is map
        && f.keys().hasOnly(['yearBuilt', 'roomOrder', 'notes', 'summary', 'scopeConfirmed',
          'airMovers', 'dehumidifiers', 'airScrubbers', 'dryingDays', 'woodFloorSystems',
          'woodFloorDays', 'emergencyCalls', 'monitoringHours', 'haulLoads', 'hepaFilters',
          'matterportScans', 'dumpTruckLoads', 'equipmentDecon', 'powerDistribution',
          'laborHours', 'isAfterHours'])
        && okInt(f, 'yearBuilt', 1800, request.time.year())
        && okList(f, 'roomOrder', 30)
        && okText(f, 'notes', 0, 40000)
        && okText(f, 'summary', 0, 6000)
        && okBool(f, 'scopeConfirmed')
        && okInt(f, 'airMovers', 0, 100)
        && okInt(f, 'dehumidifiers', 0, 100)
        && okInt(f, 'airScrubbers', 0, 100)
        && okInt(f, 'dryingDays', 1, 60)
        && okInt(f, 'woodFloorSystems', 0, 100)
        && okInt(f, 'woodFloorDays', 1, 60)
        && okInt(f, 'emergencyCalls', 0, 100)
        && okNumber(f, 'monitoringHours', 0, 500)
        && okInt(f, 'haulLoads', 0, 100)
        && okInt(f, 'hepaFilters', 0, 100)
        && okInt(f, 'matterportScans', 0, 100)
        && okInt(f, 'dumpTruckLoads', 0, 100)
        && okInt(f, 'equipmentDecon', 0, 100)
        && okInt(f, 'powerDistribution', 0, 100)
        && okNumber(f, 'laborHours', 0, 500)
        && okBool(f, 'isAfterHours');
    }

    function validRoomField(f) {
      return f is map
        && f.keys().hasOnly(['name', 'category', 'unfinishedSf', 'finishedSf', 'floorSf',
          'wetFloorSf', 'wastePercent'])
        && okText(f, 'name', 1, 100)
        && okInt(f, 'category', 1, 3)
        && okNumber(f, 'unfinishedSf', 0, 100000)
        && okNumber(f, 'finishedSf', 0, 100000)
        && (!('floorSf' in f) || (f.floorSf is number && f.floorSf > 0 && f.floorSf <= 100000))
        && okNumber(f, 'wetFloorSf', 0, 100000)
        && okNumber(f, 'wastePercent', 0, 100);
    }

    function validPhotoField(f) {
      return f is map
        && f.keys().hasOnly(['roomId', 'shotTag'])
        && okId(f, 'roomId')
        && (!('shotTag' in f)
          || f.shotTag in ['overview', 'source', 'surface', 'meter', 'contents', 'equipment']);
    }

    match /companies/{companyId}/drafts/{draftId} {
      function draft() {
        return get(/databases/$(database)/documents/companies/$(companyId)/drafts/$(draftId)).data;
      }

      // A nested document holds only `field`, and that map is valid. A client deletes only a room
      // (below), never a photo reference.
      function nestedCreate(valid) {
        return canEdit(companyId, draft())
          && request.resource.data.keys().hasOnly(['field'])
          && valid;
      }

      function nestedUpdate(valid) {
        return canEdit(companyId, draft()) && changesOnlyField() && valid;
      }

      // Drafts are created and removed by the server only.
      allow read: if canRead(companyId, resource.data);
      allow update: if canEdit(companyId, resource.data)
        && changesOnlyField()
        && validDraftField(request.resource.data.field);

      // Each room and each photo reference is its own document; no other collection, and nothing
      // deeper, is open to a client.
      match /rooms/{roomId} {
        allow read: if canRead(companyId, draft());
        allow create: if nestedCreate(validRoomField(request.resource.data.field));
        allow update: if nestedUpdate(validRoomField(request.resource.data.field));
        // Removing a room (owner decision, 2026-11-13, S5a-6): only its field owner, while the draft
        // is editing. The phone removes the room from `roomOrder` in the same batch.
        allow delete: if canEdit(companyId, draft());
      }

      match /photos/{photoId} {
        allow read: if canRead(companyId, draft());
        allow create: if nestedCreate(validPhotoField(request.resource.data.field));
        allow update: if nestedUpdate(validPhotoField(request.resource.data.field));
      }
    }
  }
}
