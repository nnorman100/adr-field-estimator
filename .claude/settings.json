{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/push-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/stop-checks.mjs\"",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*service-account*.json)",
      "Read(./**/*.key)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.*)",
      "Read(~/.config/gcloud/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin master:*)",
      "Bash(git * push --force*)",
      "Bash(git * push -f*)",
      "Bash(git * push origin master*)",
      "Bash(firebase deploy)",
      "Bash(firebase deploy --project:*)"
    ],
    "ask": [
      "Bash(firebase deploy:*)",
      "Bash(firebase auth:*)",
      "Bash(gcloud run deploy:*)",
      "Bash(gcloud run services update-traffic:*)",
      "Bash(gcloud run services update:*)",
      "Bash(gcloud secrets:*)",
      "Bash(gcloud projects add-iam-policy-binding:*)",
      "Bash(python scripts/deploy_backend.py:*)",
      "Bash(python scripts/stamp_hosting.py:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh-axi pr merge:*)",
      "Bash(gh-axi pr edit:*)"
    ]
  }
}
