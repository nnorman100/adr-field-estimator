{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/push-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/stop-checks.mjs\"",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "code-to-design": "off",
    "stitch::code-to-design": "off",
    "design-md": "off",
    "enhance-prompt": "off",
    "extract-design-md": "off",
    "stitch::extract-design-md": "off",
    "extract-static-html": "off",
    "stitch::extract-static-html": "off",
    "generate-design": "off",
    "stitch::generate-design": "off",
    "manage-design-system": "off",
    "stitch::manage-design-system": "off",
    "react-components": "off",
    "stitch::react-components": "off",
    "react-native": "off",
    "react-vite-dashboard": "off",
    "remotion": "off",
    "shadcn-ui": "off",
    "site-md": "off",
    "stitch-loop": "off",
    "taste-design": "off",
    "upload-to-stitch": "off",
    "stitch::upload-to-stitch": "off"
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*service-account*.json)",
      "Read(./**/*.key)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.*)",
      "Read(~/.config/gcloud/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin master:*)",
      "Bash(git * push --force*)",
      "Bash(git * push -f*)",
      "Bash(git * push origin master*)",
      "Bash(firebase deploy)",
      "Bash(firebase deploy --project:*)",
      "Bash(gcloud secrets:*)",
      "Bash(gh secret:*)"
    ],
    "ask": [
      "Bash(firebase deploy:*)",
      "Bash(firebase auth:*)",
      "Bash(gcloud run deploy:*)",
      "Bash(gcloud run services update-traffic:*)",
      "Bash(gcloud run services update:*)",
      "Bash(gcloud projects add-iam-policy-binding:*)",
      "Bash(python scripts/deploy_backend.py:*)",
      "Bash(python scripts/stamp_hosting.py:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh-axi pr merge:*)",
      "Bash(gh-axi pr edit:*)"
    ]
  }
}
